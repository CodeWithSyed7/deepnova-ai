{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/client",
  "redirects": [
    {
      "source": "/auth/handoff/begin",
      "destination": "https://ai-chat-6gfzjw-preview.freebuff.site/auth/handoff/begin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|auth/handoff/begin).*)",
      "destination": "/index.html"
    }
  ]
}
