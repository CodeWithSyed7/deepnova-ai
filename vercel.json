{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-chat-6gfzjw-preview.freebuff.site/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://ai-chat-6gfzjw-preview.freebuff.site/auth/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
